# Auto detect text files and perform LF normalization
* text=auto

# Identical text checkouts on Windows/macOS; binary Unreal assets must not merge as text.
*.sh text eol=lf
*.ps1 text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.uproject text eol=lf
*.uasset binary
*.umap binary
*.py text eol=lf

# Binary media, models and archives: never normalize line endings or merge as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.bmp binary
*.psd binary
*.ase binary
*.aseprite binary
*.ai binary
*.eps binary
*.pdf binary
*.fbx binary
*.blend binary
*.otf binary
*.ttf binary
*.mp3 binary
*.wav binary
*.ogg binary
*.zip binary
*.7z binary
*.pck binary
*.exe binary
*.dll binary
