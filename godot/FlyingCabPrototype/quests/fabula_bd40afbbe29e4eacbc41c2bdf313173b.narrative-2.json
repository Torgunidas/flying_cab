  "dialogues": [
    {
      "id": "quest_85815f3b769f4aaabd844376e2becc21_dialogue",
      "start_node": "offer",
      "nodes": [
        {
          "id": "offer",
          "speaker": "BRUNO",
          "text": "Więc to ty jesteś tym nowym macherem w mieście.",
          "choices": [
            {
              "id": "c_5ad291c3ef29488eac9c251932fa35ab",
              "text": "Ja? Nie powiedziałbym.",
              "next_node": "n_94436462e37040a5b2c305db3a0fe599",
              "conditions": [],
              "effects": [],
              "once": false,
              "hide_unavailable": false
            }
          ]
        },
        {
          "id": "n_94436462e37040a5b2c305db3a0fe599",
          "speaker": "BRUNO",
          "text": "Dobra,dobra. Widzę,jak ci z oczu patrzy. Zrobisz coś dla mnie.",
          "choices": [
            {
              "id": "c_1eea799db5a441e2b2903940724ab6a1",
              "text": "Czemu mam coś dla ciebie robić?",
              "next_node": "n_acaaca596fb34daba5667ed341bca1d7",
              "conditions": [],
              "effects": [],
              "once": false,
              "hide_unavailable": false
            }
          ]
        },
        {
          "id": "n_acaaca596fb34daba5667ed341bca1d7",
          "speaker": "BRUNO",
          "text": "Przecież wiesz, jak to działa. Ty zrobisz coś dla mnie, ja zrobię coś dla ciebie i tak to się kręci.",
          "choices": [
            {
              "id": "c_c58fb9bf232e43978940876ecddc076a",
              "text": "[sb]Wzdychasz.[/sb] Niech będzie. Czego chcesz?",
              "next_node": "n_ae081305a33d42dab1245f200fe0f83d",
              "conditions": [],
              "effects": [],
              "once": false,
              "hide_unavailable": false
            }
          ]
        },
        {
          "id": "n_ae081305a33d42dab1245f200fe0f83d",
          "speaker": "BRUNO",
          "text": "Widziałem na mieście nowy model wozu. CHWDP 14V. Muszę go mieć i tymi go zdobędziesz.",
          "choices": [
            {
              "id": "c_552a3f321efc4e368bebcdfadbb2a0f3",
              "text": "Mam kraść?",
              "next_node": "n_1a555b5cda7f4a2699135396fbe9b2a1",
              "conditions": [],
              "effects": [],
              "once": false,
              "hide_unavailable": false
            }
          ]
        },
        {
          "id": "n_1a555b5cda7f4a2699135396fbe9b2a1",
          "speaker": "BRUNO",
          "text": "Kraść? Oczywiście, że nie. Ty tylko przywrócisz dziejową sprawiedliwość.",
          "choices": [
            {
              "id": "accept",
              "text": "Dobra, zajmę się tym.",
              "next_node": "active",
              "conditions": [],
              "effects": [
                {
                  "kind": "start_quest",
                  "key": "quest_85815f3b769f4aaabd844376e2becc21",
                  "amount": 1,
                  "value": 0
                }
              ],
              "once": false,
              "hide_unavailable": false
            },
            {
              "id": "decline",
              "text": "Nie teraz.",
              "next_node": "",
              "conditions": [],
              "effects": [],
              "once": false,
              "hide_unavailable": false
            }
          ]
        },
        {
          "id": "active",
          "speaker": "BRUNO",
          "text": "Gdzie moje autko?",
          "choices": [
            {
              "id": "leave_active",
              "text": "Będzie, nie martw się.",
              "next_node": "",
              "conditions": [],
              "effects": [],
