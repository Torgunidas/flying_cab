[sub_resource type="Resource" id="r0"]
script = ExtResource("s_narrative_condition")
kind = "medicine"
reason = "Nie masz dawki."

[sub_resource type="Resource" id="r1"]
script = ExtResource("s_narrative_condition")
kind = "campaign_active"
reason = "Odliczanie nie jest aktywne."

[sub_resource type="Resource" id="r2"]
script = ExtResource("s_narrative_effect")
kind = "deliver_medicine"
value = 600.0

[sub_resource type="Resource" id="r3"]
script = ExtResource("s_dialogue_choice")
id = &"give"
text = "Podaj dawkę."
next_node = &"thanks"
conditions = Array[ExtResource("s_narrative_condition")]([SubResource("r0"), SubResource("r1")])
effects = Array[ExtResource("s_narrative_effect")]([SubResource("r2")])

[sub_resource type="Resource" id="r4"]
script = ExtResource("s_dialogue_node")
id = &"give"
text = "Masz lek? Pomóż mi go przyjąć."
choices = Array[ExtResource("s_dialogue_choice")]([SubResource("r3")])

[sub_resource type="Resource" id="r5"]
script = ExtResource("s_dialogue_choice")
id = &"leave"
text = "Odpocznij."

[sub_resource type="Resource" id="r6"]
script = ExtResource("s_dialogue_node")
id = &"thanks"
text = "Dziękuję. Czuję, że zaczyna działać."
choices = Array[ExtResource("s_dialogue_choice")]([SubResource("r5")])

[resource]
script = ExtResource("s_dialogue_definition")
id = &"maya_medicine"
start_node = &"give"
nodes = Array[ExtResource("s_dialogue_node")]([SubResource("r4"), SubResource("r6")])
