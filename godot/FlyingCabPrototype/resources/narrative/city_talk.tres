[sub_resource type="Resource" id="r0"]
script = ExtResource("s_narrative_condition")
key = &"promised_froggy"
reason = "Nie składano jeszcze obietnicy."

[sub_resource type="Resource" id="r1"]
script = ExtResource("s_dialogue_choice")
id = &"promise"
text = "Pamiętam o naszej umowie."
conditions = Array[ExtResource("s_narrative_condition")]([SubResource("r0")])
hide_unavailable = true

[sub_resource type="Resource" id="r2"]
script = ExtResource("s_dialogue_choice")
id = &"leave"
text = "Rozejrzę się."

[sub_resource type="Resource" id="r3"]
script = ExtResource("s_dialogue_node")
id = &"talk"
text = "W tym mieście zawsze ktoś czeka na przejazd. Pilnuj paliwa i wracaj do ludzi, którym coś obiecałeś."
choices = Array[ExtResource("s_dialogue_choice")]([SubResource("r1"), SubResource("r2")])

[resource]
script = ExtResource("s_dialogue_definition")
id = &"city_talk"
start_node = &"talk"
nodes = Array[ExtResource("s_dialogue_node")]([SubResource("r3")])
