[sub_resource type="Resource" id="Resource_ewt7h"]
script = ExtResource("3_2tqcx")
id = &"offer"
speaker = "BRUNO"
text = "Więc to ty jesteś tym nowym macherem w mieście."
choices = Array[ExtResource("4_4wyjf")]([SubResource("Resource_mbwst")])

[sub_resource type="Resource" id="Resource_wnnp3"]
script = ExtResource("4_4wyjf")
id = &"c_1eea799db5a441e2b2903940724ab6a1"
text = "Czemu mam coś dla ciebie robić?"
next_node = &"n_acaaca596fb34daba5667ed341bca1d7"

[sub_resource type="Resource" id="Resource_lpyg0"]
script = ExtResource("3_2tqcx")
id = &"n_94436462e37040a5b2c305db3a0fe599"
speaker = "BRUNO"
text = "Dobra,dobra. Widzę,jak ci z oczu patrzy. Zrobisz coś dla mnie."
choices = Array[ExtResource("4_4wyjf")]([SubResource("Resource_wnnp3")])

[sub_resource type="Resource" id="Resource_dy4w6"]
script = ExtResource("4_4wyjf")
id = &"c_c58fb9bf232e43978940876ecddc076a"
text = "[sb]Wzdychasz.[/sb] Niech będzie. Czego chcesz?"
next_node = &"n_ae081305a33d42dab1245f200fe0f83d"

[sub_resource type="Resource" id="Resource_od0dd"]
script = ExtResource("3_2tqcx")
id = &"n_acaaca596fb34daba5667ed341bca1d7"
speaker = "BRUNO"
text = "Przecież wiesz, jak to działa. Ty zrobisz coś dla mnie, ja zrobię coś dla ciebie i tak to się kręci."
choices = Array[ExtResource("4_4wyjf")]([SubResource("Resource_dy4w6")])

[sub_resource type="Resource" id="Resource_ac5mg"]
script = ExtResource("4_4wyjf")
id = &"c_552a3f321efc4e368bebcdfadbb2a0f3"
text = "Mam kraść?"
next_node = &"n_1a555b5cda7f4a2699135396fbe9b2a1"

[sub_resource type="Resource" id="Resource_qqfny"]
script = ExtResource("3_2tqcx")
id = &"n_ae081305a33d42dab1245f200fe0f83d"
speaker = "BRUNO"
text = "Widziałem na mieście nowy model wozu. CHWDP 14V. Muszę go mieć i tymi go zdobędziesz."
choices = Array[ExtResource("4_4wyjf")]([SubResource("Resource_ac5mg")])

