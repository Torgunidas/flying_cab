[gd_resource type="Resource" script_class="DialogueDefinition" format=3 uid="uid://b5k1swwl0sc4g"]

[ext_resource type="Script" uid="uid://bxilgskfvq203" path="res://scripts/narrative/dialogue_choice.gd" id="s_dialogue_choice"]
[ext_resource type="Script" uid="uid://cyk54eteh2oga" path="res://scripts/narrative/dialogue_definition.gd" id="s_dialogue_definition"]
[ext_resource type="Script" uid="uid://bbj1vgka3aqlb" path="res://scripts/narrative/dialogue_entry.gd" id="s_dialogue_entry"]
[ext_resource type="Script" uid="uid://c04a45t5qg5yl" path="res://scripts/narrative/dialogue_node.gd" id="s_dialogue_node"]
[ext_resource type="Script" uid="uid://dps33dkdjcmlf" path="res://scripts/narrative/narrative_condition.gd" id="s_narrative_condition"]
[ext_resource type="Script" uid="uid://blfaeixmm3cs6" path="res://scripts/narrative/narrative_effect.gd" id="s_narrative_effect"]

[sub_resource type="Resource" id="r11"]
script = ExtResource("s_narrative_condition")
kind = "quest_status"
key = &"first_dose"

[sub_resource type="Resource" id="r12"]
script = ExtResource("s_dialogue_entry")
node_id = &"active"
conditions = Array[ExtResource("s_narrative_condition")]([SubResource("r11")])

[sub_resource type="Resource" id="r13"]
script = ExtResource("s_narrative_condition")
kind = "quest_status"
key = &"first_dose"
status = "completed"

[sub_resource type="Resource" id="r14"]
script = ExtResource("s_dialogue_entry")
node_id = &"done"
conditions = Array[ExtResource("s_narrative_condition")]([SubResource("r13")])

[sub_resource type="Resource" id="r0"]
script = ExtResource("s_narrative_effect")
kind = "start_campaign"
amount = 600.0

[sub_resource type="Resource" id="r1"]
script = ExtResource("s_narrative_effect")
kind = "start_quest"
key = &"first_dose"

[sub_resource type="Resource" id="r2"]
script = ExtResource("s_dialogue_choice")
id = &"accept"
text = "Wrócę z lekiem."
next_node = &"accepted"
effects = Array[ExtResource("s_narrative_effect")]([SubResource("r0"), SubResource("r1")])
once = true

[sub_resource type="Resource" id="r3"]
script = ExtResource("s_dialogue_choice")
id = &"later"
text = "Jeszcze chwila."

[sub_resource type="Resource" id="r4"]
script = ExtResource("s_dialogue_node")
id = &"offer"
text = "Substancja przestaje działać. Froggy ma kolejną dawkę na tarasie Torque, po drugiej stronie Foundry. Wrócisz do mnie?"
choices = Array[ExtResource("s_dialogue_choice")]([SubResource("r2"), SubResource("r3")])

[sub_resource type="Resource" id="r5"]
script = ExtResource("s_dialogue_choice")
id = &"leave"
text = "Zaraz wracam."

[sub_resource type="Resource" id="r6"]
script = ExtResource("s_dialogue_node")
id = &"accepted"
text = "Będę czekać. Porcja kosztuje 160 CR. Jeśli brakuje ci pieniędzy, zrób kilka kursów."
choices = Array[ExtResource("s_dialogue_choice")]([SubResource("r5")])

[sub_resource type="Resource" id="r7"]
script = ExtResource("s_dialogue_choice")
id = &"leave"
text = "Pamiętam."

[sub_resource type="Resource" id="r8"]
script = ExtResource("s_dialogue_node")
id = &"active"
text = "Masz {medicine} dawek i {credits} CR. Najważniejsze, żebyś wrócił z lekiem."
choices = Array[ExtResource("s_dialogue_choice")]([SubResource("r7")])

[sub_resource type="Resource" id="r9"]
script = ExtResource("s_dialogue_choice")
id = &"leave"
text = "Zadbam o to."

[sub_resource type="Resource" id="r10"]
script = ExtResource("s_dialogue_node")
id = &"done"
text = "Jest lepiej. Dziękuję, Ari. Lek daje nam czas, ale będę potrzebowała kolejnej dawki."
choices = Array[ExtResource("s_dialogue_choice")]([SubResource("r9")])

[resource]
script = ExtResource("s_dialogue_definition")
id = &"maya_help"
start_node = &"offer"
entries = Array[ExtResource("s_dialogue_entry")]([SubResource("r12"), SubResource("r14")])
nodes = Array[ExtResource("s_dialogue_node")]([SubResource("r4"), SubResource("r6"), SubResource("r8"), SubResource("r10")])
