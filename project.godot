; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FlyingCab"
run/main_scene="uid://dy0b0lt64gpho"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

VehPers="*res://scripts/VehiclePersistence.gd"
GameState="*res://scripts/GameState.gd"
QuestSys="*res://scenes/QuestSysRoot.tscn"
UISys="*res://scenes/ui_scenes/QuestLog.tscn"
pauza="*res://scripts/ui_logic/PauseSys.gd"
QuestObjectiveUi="*res://scenes/ui_scenes/QuestObjectiveUI.tscn"
FlyThruNeon="*res://scripts/ui_logic/fly_thru_neon.gd"
MessageSystem="*res://scenes/ui_scenes/SystemMessageUI.tscn"

[display]

window/size/viewport_width=1000
window/size/viewport_height=1600
window/size/mode=1
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/dialog_editor/plugin.cfg")

